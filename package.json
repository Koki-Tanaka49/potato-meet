{
  "name": "potato-meet",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "A Chrome extension that overlays animated potatoes on faces in Google Meet",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "model": "node scripts/fetch-model.mjs",
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "release:check": "npm run package && node scripts/package.mjs --check",
    "check:mediapipe": "node scripts/check-mediapipe-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && playwright test",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.21"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.3",
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.9",
    "happy-dom": "^20.11.6",
    "sharp": "^0.35.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
