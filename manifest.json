{
  "manifest_version": 3,
  "name": "Potato Meet",
  "version": "0.3.1",
  "description": "Cover other participants' faces in Google Meet with animated potatoes, processed entirely in your browser.",
  "action": {
    "default_title": "Potato Meet",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "face-tracker-worker.js",
        "mediapipe/wasm/*",
        "models/face_landmarker.task",
        "potato/*.png"
      ],
      "matches": ["https://meet.google.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
